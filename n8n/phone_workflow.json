      {
        "parameters": {
          "respondWith": "text",
          "responseBody": "=<?xml version=\"1.0\" encoding=\"UTF-8\"?><Response><Say voice=\"Polly.Lucia-Neural\" language=\"es-ES\">Perfecto, un momento, te preparo el pedido.</Say><Pause length=\"10\"/><Redirect method=\"POST\">https://trodden-donator-untitled.ngrok-free.dev/webhook/twilio-respuesta?t={{ $json.query.t || 1 }}&amp;n=0</Redirect></Response>",
          "options": {
