          0,
          1000
        ],
        "webhookId": "33009f37-13b3-5693-9fe9-987f276ec6b6"
      },
      {
        "parameters": {
          "jsCode": "const b = $input.first().json.body || {};\nconst q = $input.first().json.query || {};\nconst turn = Number(q.t || 1);\nconst poll = Number(q.n || 0);\nconst r = ($getWorkflowStaticData('global').calls || {})[b.CallSid + ':' + turn];\nlet state = 'wait';\nif (r) state = r.error ? 'failed' : r.unknown ? 'unknown' : turn < 2 ? 'listen' : 'close';\nelse if (poll >= 6) state = 'failed';\n// spoken text: S00052 is read as «ese cincuenta y dos», no symbols of Markdown, XML escaped\nconst say = ((r && r.reply) || '')\n  .replace(/\\b([A-Z]{1,4})0+(\\d+)\\b/g, '$1 $2')\n  .replace(/[*_#`>]/g, '')\n  .replace(/\\s*\\n+\\s*/g, '. ')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nreturn [{ json: { state, turn, poll, say } }];"
        },
