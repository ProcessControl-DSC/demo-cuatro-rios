      {
        "parameters": {
          "respondWith": "text",
          "responseBody": "=<?xml version=\"1.0\" encoding=\"UTF-8\"?><Response><Gather input=\"speech\" language=\"es-ES\" speechTimeout=\"3\" timeout=\"6\" hints=\"parrillero, chorizo parrillero, picadillo, hamburguesa, burger, costilla, costilla adobada, carne fiesta, pack barbacoa, oferta de la semana, lo de siempre, kilos, cajas, unidades, bandejas\" action=\"https://trodden-donator-untitled.ngrok-free.dev/webhook/twilio-pedido?t=1\" method=\"POST\"><Say voice=\"Polly.Lucia-Neural\" language=\"es-ES\">Hola, has llamado a pedidos de Cuatro Ríos. Dime qué necesitas, por ejemplo: diez kilos de parrillero y dos cajas de picadillo.</Say></Gather><Gather input=\"speech\" language=\"es-ES\" speechTimeout=\"3\" timeout=\"6\" hints=\"parrillero, chorizo parrillero, picadillo, hamburguesa, burger, costilla, costilla adobada, carne fiesta, pack barbacoa, oferta de la semana, lo de siempre, kilos, cajas, unidades, bandejas\" action=\"https://trodden-donator-untitled.ngrok-free.dev/webhook/twilio-pedido?t=1\" method=\"POST\"><Say voice=\"Polly.Lucia-Neural\" language=\"es-ES\">¿Sigues ahí? Dime tu pedido.</Say></Gather><Say voice=\"Polly.Lucia-Neural\" language=\"es-ES\">No te he oído. Puedes volver a llamar cuando quieras. Hasta luego.</Say></Response>",
          "options": {
