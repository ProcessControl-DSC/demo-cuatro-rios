        "id": "148c38a3-5e76-540e-b2b0-e92174b7f35c",
        "name": "Un momento",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.5,
        "position": [
          260,
          560
        ]
      },
      {
        "parameters": {
          "jsCode": "const b = $input.first().json.body || {};\nconst q = $input.first().json.query || {};\nreturn [{ json: {\n  channel: 'phone',\n  chat_id: b.CallSid,\n  sender_name: b.From,\n  text: (b.SpeechResult || '').trim(),\n  phone: b.From,\n  turn: Number(q.t || 1),\n}}];"
        },
        "id": "53bda15d-8545-540a-8a35-cefec04ca40d",
        "name": "Preparar para Odoo",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          500,
          560
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://processcontrol-dsc-demo-cuatro-rios.odoo.com/pc_ai_order_intake/messaging",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({channel: $json.channel, chat_id: $json.chat_id, sender_name: $json.sender_name, text: $json.text, phone: $json.phone}) }}",
          "options": {
            "timeout": 120000
          }
        },
        "id": "a5a54de9-f055-5ed2-9758-daf938b0ace2",
        "name": "Odoo: preparar pedido",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          740,
          560
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "18c28beee2514b0b",
            "name": "Odoo pedidos Cuatro Ríos"
          }
        },
        "onError": "continueErrorOutput"
      },
      {
        "parameters": {
          "jsCode": "const data = $getWorkflowStaticData('global');\nconst calls = data.calls || {};\nconst now = Date.now();\nfor (const key of Object.keys(calls)) {\n  if (now - calls[key].at > 3600 * 1000) delete calls[key];\n}\nconst prep = $('Preparar para Odoo').first().json;\nconst r = $input.first().json;\ncalls[prep.chat_id + ':' + prep.turn] = {\n  at: now,\n  error: Boolean(r.error) || !(r.reply || r.need_contact),\n  unknown: Boolean(r.need_contact),\n  reply: r.reply || '',\n  quotations: (r.quotations || []).map(q => q.name),\n};\ndata.calls = calls;\nreturn [{ json: calls[prep.chat_id + ':' + prep.turn] }];"
        },
        "id": "f0dfee4f-4d01-5725-900e-45dfaac70991",
        "name": "Guardar para la llamada",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
